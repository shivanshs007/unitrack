// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SearchLog {
  id        Int      @id @default(autoincrement())
  query     String
  type      String
  createdAt DateTime @default(now())
}

model Room {
  id        String        @id @default(uuid())
  pin       String        @unique // The 6-digit code (e.g. "123456")
  createdAt DateTime      @default(now())
  expiresAt DateTime      // Auto-cleanup (e.g. 24 hours)
  members   Participant[]
}

model Participant {
  id        String   @id @default(uuid())
  name      String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  
  // Location Data
  latitude  Float
  longitude Float
  lastSeen  DateTime @default(now()) // Used to filter out offline users
}